# StudyMate AI Backend Environment Configuration

# Server
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Gemini AI (Required for RAG & Quiz generation in future milestones)
# Never expose this to client-side code!
GEMINI_API_KEY=
GEMINI_MODEL_POOL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
